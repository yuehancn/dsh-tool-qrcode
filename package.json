{
  "name": "dsh-tool-qrcode",
  "version": "1.0.0",
  "description": "Encode and decode QR codes from DeepSeek Harness, with symbol-capacity planning: pick the error-correction level, check the payload fits, and know the printed size needed for a scanning distance.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "qrcode",
    "qr",
    "barcode",
    "svg",
    "encode",
    "decode"
  ],
  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-qrcode.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-qrcode#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-qrcode/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}